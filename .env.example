# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# SQLite file (relative to the repo root). Use :memory: for ephemeral runs.
DATABASE_FILE=.data/zevanto.db
SEED_DATABASE=true

# ---------------------------------------------------------------------------
# Security — CHANGE THESE BEFORE DEPLOYING
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_PIN=1234
ADMIN_TOKEN_SECRET=dev-only-insecure-secret-change-me
# Admin session lifetime in seconds (default 1 hour)
ADMIN_TOKEN_TTL_SECONDS=3600

# Comma-separated list of allowed browser origins, or * for local development.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# PIN attempts per window — deliberately tight.
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Release metadata (surfaced by /health/version)
# ---------------------------------------------------------------------------
APP_VERSION=0.1.0
COMMIT_SHA=unknown

# ---------------------------------------------------------------------------
# Web client (Vite)
# Leave VITE_API_BASE_URL empty to call /api on the same origin (recommended).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_APP_VERSION=0.1.0
